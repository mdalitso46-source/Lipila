# Copy to .env.local. Never commit real values.

# Show the one-time code on screen. There is no SMS provider.
# Set to false only if you wire a real SMS sender.
DEMO_MODE=true

# 32-byte key, hex (64 chars) or base64. Encrypts custodial Stellar secrets at rest.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_ENCRYPTION_KEY=replace-with-32-byte-hex

# Signs the session cookie.
SESSION_SECRET=replace-with-a-long-random-string

# Public URL used in claim links. Optional locally (the request host is used).
APP_URL=http://localhost:3000

# Storage.
# 1. DATABASE_URL — any Postgres. Lipila creates tables on startup.
# 2. NETLIFY_DB_URL — set automatically on Netlify when @netlify/database is installed.
#    Schema comes from netlify/database/migrations (applied by the deploy).
# 3. If neither is set, local dev uses a JSON file in .data/ (demo fallback).
#    That file is not writable on Netlify. Deploy with Netlify Database or DATABASE_URL.
DATABASE_URL=

# Stellar testnet. Defaults match SDF Horizon, Friendbot, and Circle's testnet USDC.
HORIZON_URL=https://horizon-testnet.stellar.org
FRIENDBOT_URL=https://friendbot.stellar.org
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
ANCHOR_HOME_DOMAIN=testanchor.stellar.org

# XLM sold for starter USDC when the Circle faucet does not deliver.
STARTER_XLM=20
