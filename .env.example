# Copy to .env.local. Never commit real values.

# Hosted demo default. The code is shown on screen. No SMS account is required.
# Live delivery is phase 2. Switch to africastalking or twilio only then.
# africastalking — Africa's Talking. Needs AT_USERNAME and AT_API_KEY.
# twilio — Twilio Programmable SMS. Needs TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM_NUMBER.
SMS_PROVIDER=demo

# Keep true for the hosted demo. Production starts with this set.
# Set false only in phase 2, after a real SMS provider is configured.
DEMO_MODE=true

# Africa's Talking. Sandbox username is usually "sandbox".
# Dashboard: https://account.africastalking.com/
AT_USERNAME=
AT_API_KEY=
# Optional sender ID. Omit it on the sandbox if you have not registered one.
AT_SENDER_ID=
# Optional override. Default is the live messaging API.
AT_API_URL=https://api.africastalking.com/version1/messaging

# Twilio. From must be a Twilio number or an approved sender.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# 32-byte key, hex (64 chars) or base64. Encrypts custodial Stellar secrets at rest.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_ENCRYPTION_KEY=replace-with-32-byte-hex

# Signs the session cookie.
SESSION_SECRET=replace-with-a-long-random-string

# Public URL used in claim links and the SEP-24 wallet_url. Optional locally.
APP_URL=http://localhost:3000

# Storage. Pick one.
# 1. DATABASE_URL — any Postgres, including Supabase.
#    Use the session pooler (port 5432), not the transaction pooler (port 6543).
#    Example: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
#    Lipila creates tables on startup from netlify/database/migrations.
# 2. NETLIFY_DB_URL — set automatically on Netlify when @netlify/database is installed.
#    Schema comes from netlify/database/migrations (applied by the deploy, not by the app).
# 3. If neither is set, local dev uses a JSON file in .data/ (demo fallback).
#    That file is not writable on Netlify.
DATABASE_URL=

# Stellar testnet. Do not point these at mainnet.
HORIZON_URL=https://horizon-testnet.stellar.org
FRIENDBOT_URL=https://friendbot.stellar.org
# Circle testnet USDC. Change only if you deliberately use another test asset.
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# SEP-24 anchor. testanchor.stellar.org is the sandbox stand-in for Airtel Money / MTN MoMo.
# A Zambian anchor replaces this value only. No code change.
ANCHOR_HOME_DOMAIN=testanchor.stellar.org

# XLM sold for starter USDC when the Circle faucet does not deliver.
STARTER_XLM=20
